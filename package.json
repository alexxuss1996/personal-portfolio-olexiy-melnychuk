    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@iconify-json/fa": "^1.2.2",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.100",
    "@types/eslint": "^9.6.1",
    "@types/node": "^26.6.5",
    "@types/prettier": "^3.0.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
