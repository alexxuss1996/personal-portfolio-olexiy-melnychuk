---
import { Resend } from "resend";
import { Icon } from "astro-icon/components";
import { getSecret } from "astro:env/server";
import {
  buildContactEmail,
  createEmptyContactValues,
  readContactValues,
  validateContact,
  type ContactField,
  type ContactFieldErrors,
} from "../lib/contact";

const resend = new Resend(getSecret("RESEND_API_KEY"));

const formValues = createEmptyContactValues();
let fieldErrors: ContactFieldErrors = {};
let formError = "";
let wasSent = false;

if (Astro.request.method === "POST") {
  try {
    const submitted = readContactValues(await Astro.request.formData());
    Object.assign(formValues, submitted);
    fieldErrors = validateContact(formValues);

    if (Object.keys(fieldErrors).length === 0) {
      const email = buildContactEmail(formValues);
      const { error } = await resend.emails.send({
        to: [getSecret("RECIPIENT_EMAIL_ADDRESS") as string],
        from: getSecret("RESEND_FROM_EMAIL") || "onboarding@resend.dev",
        replyTo: formValues.email,
        ...email,
      });

      if (error) {
        console.error(error);
        formError = "Message could not be sent. Please try again.";
      } else {
        wasSent = true;
        Object.assign(formValues, createEmptyContactValues());
      }

      console.log(wasSent ? "Message sent" : "Message failed");
    }
  } catch (error) {
    console.error(error);
    formError = "Message could not be sent. Please try again.";
  }
}

const fieldClass = (field: ContactField) =>
  `rounded-lg border bg-panel px-4 py-3 font-body text-sm text-ink placeholder:text-muted focus:outline-none focus:ring-2 ${
    fieldErrors[field]
      ? "border-red-600 focus:ring-red-500 dark:border-red-400"
      : "border-field-line focus:ring-accent-fill"
  }`;
---

<form method="post" action="/#contact" class="space-y-4" data-contact-form>
  {wasSent && (
    <p
      role="status"
      class="rounded-lg border border-accent/40 bg-accent/10 px-4 py-3 font-body text-sm text-ink"
    >
      Thanks, your message was sent. I'll get back to you soon.
    </p>
  )}
  {formError && (
    <p
      role="alert"
      class="rounded-lg border border-red-600/50 bg-red-600/10 px-4 py-3 font-body text-sm text-red-700 dark:border-red-400/50 dark:text-red-400"
    >
      {formError}
    </p>
  )}

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <label class="flex flex-col gap-1.5 font-display text-[11px] uppercase tracking-wider text-muted">
      <span>
        First Name{" "}
        <span aria-hidden="true" class="text-red-600 dark:text-red-400">
          *
        </span>
      </span>
      <input
        name="name"
        type="text"
        required
        minlength="2"
        maxlength="60"
        autocomplete="given-name"
        placeholder="e.g. John"
        value={formValues.name}
        aria-invalid={fieldErrors.name ? "true" : undefined}
        aria-describedby={fieldErrors.name ? "error-name" : undefined}
        class={fieldClass("name")}
      />
      {fieldErrors.name && (
        <span
          id="error-name"
          class="normal-case text-red-700 dark:text-red-400"
        >
          {fieldErrors.name}
        </span>
      )}
    </label>
    <label class="flex flex-col gap-1.5 font-display text-[11px] uppercase tracking-wider text-muted">
      Last Name
      <input
        name="surname"
        type="text"
        maxlength="60"
        autocomplete="family-name"
        placeholder="e.g. Doe"
        value={formValues.surname}
        aria-invalid={fieldErrors.surname ? "true" : undefined}
        aria-describedby={fieldErrors.surname ? "error-surname" : undefined}
        class={fieldClass("surname")}
      />
      {fieldErrors.surname && (
        <span
          id="error-surname"
          class="normal-case text-red-700 dark:text-red-400"
        >
          {fieldErrors.surname}
        </span>
      )}
    </label>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <label class="flex flex-col gap-1.5 font-display text-[11px] uppercase tracking-wider text-muted">
      <span>
        Email Address{" "}
        <span aria-hidden="true" class="text-red-600 dark:text-red-400">
          *
        </span>
      </span>
      <input
        name="email"
        type="email"
        required
        maxlength="254"
        autocomplete="email"
        placeholder="name@company.com"
        value={formValues.email}
        aria-invalid={fieldErrors.email ? "true" : undefined}
        aria-describedby={fieldErrors.email ? "error-email" : undefined}
        class={fieldClass("email")}
      />
      {fieldErrors.email && (
        <span
          id="error-email"
          class="normal-case text-red-700 dark:text-red-400"
        >
          {fieldErrors.email}
        </span>
      )}
    </label>
    <label class="flex flex-col gap-1.5 font-display text-[11px] uppercase tracking-wider text-muted">
      Phone Number
      <input
        name="phone"
        type="tel"
        minlength="7"
        maxlength="20"
        pattern="[+()0-9\s-]{7,20}"
        autocomplete="tel"
        placeholder="+380..."
        value={formValues.phone}
        aria-invalid={fieldErrors.phone ? "true" : undefined}
        aria-describedby={fieldErrors.phone ? "error-phone" : undefined}
        class={fieldClass("phone")}
      />
      {fieldErrors.phone && (
        <span
          id="error-phone"
          class="normal-case text-red-700 dark:text-red-400"
        >
          {fieldErrors.phone}
        </span>
      )}
    </label>
  </div>

  <label class="flex flex-col gap-1.5 font-display text-[11px] uppercase tracking-wider text-muted">
    <span>
      Message{" "}
      <span aria-hidden="true" class="text-red-600 dark:text-red-400">
        *
      </span>
    </span>
    <textarea
      name="message"
      rows="4"
      required
      minlength="10"
      maxlength="2000"
      placeholder="Describe your project, timeline, or inquiry..."
      aria-invalid={fieldErrors.message ? "true" : undefined}
      aria-describedby={fieldErrors.message ? "error-message" : undefined}
      class={`resize-none ${fieldClass("message")}`}
    >{formValues.message}</textarea>
    {fieldErrors.message && (
      <span
        id="error-message"
        class="normal-case text-red-700 dark:text-red-400"
      >
        {fieldErrors.message}
      </span>
    )}
  </label>

  <button
    type="submit"
    disabled
    class="flex w-full items-center justify-center gap-2 rounded-xl border border-accent/40 bg-accent-fill py-4 font-display text-lg font-semibold text-white transition hover:bg-accent-hover hover:shadow-[0_0_30px_var(--accent-glow)] disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:bg-accent-fill disabled:hover:shadow-none"
  >
    Send Message <Icon name="ph:paper-plane-tilt-bold" width={20} height={20} />
  </button>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");

  if (form) {
    const button = form.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    )!;
    const name = form.elements.namedItem("name") as HTMLInputElement;
    const email = form.elements.namedItem("email") as HTMLInputElement;
    const message = form.elements.namedItem("message") as HTMLTextAreaElement;

    const isComplete = () =>
      name.value.trim().length >= 2 &&
      message.value.trim().length >= 10 &&
      Boolean(email.value.trim());

    const update = () => {
      button.disabled = !isComplete();
    };

    form.addEventListener("input", update);
    form.addEventListener("change", update);
    form.addEventListener("submit", (event) => {
      if (!isComplete()) event.preventDefault();
    });

    update();
  }
</script>
