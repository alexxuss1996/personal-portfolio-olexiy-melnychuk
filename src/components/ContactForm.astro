---
import SendGrid from "@sendgrid/mail";
import { Icon } from "astro-icon/components";
SendGrid.setApiKey(import.meta.env.SENDGRID_API_KEY);

if (Astro.request.method === "POST") {
  try {
    const data = await Astro.request.formData();
    const name = data.get("name");
    const surname = data.get("surname");
    const phone = data.get("phone");
    const email = data.get("email");
    const message = data.get("message");

    const msg = {
      to: import.meta.env.RECIPIENT_EMAIL_ADDRESS as string,
      from: "alexa_11111@ukr.net",
      subject: `Message from ${name} ${surname}`,
      text: message,
      html: `<strong>Name: </strong>${name}<br><strong>Surname: </strong>${surname}<br><strong>Phone: </strong>${phone}<br><strong>Email: </strong>${email}<br><strong>Message: </strong>${message}`,
    };

    await SendGrid.send(msg as any)
      .then(() => console.log("Message sent"))
      .catch((error) => console.error(error));
  } catch (error) {
    console.error(error);
  }
}
---

<form method="post" class="space-y-4">
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <label
      class="flex flex-col gap-1.5 font-display text-[11px] uppercase tracking-wider text-muted"
    >
      First Name
      <input
        name="name"
        type="text"
        required
        autocomplete="given-name"
        placeholder="e.g. Elena"
        class="rounded-lg border border-field-line bg-panel px-4 py-3 font-body text-sm text-ink placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-accent-fill"
      />
    </label>
    <label
      class="flex flex-col gap-1.5 font-display text-[11px] uppercase tracking-wider text-muted"
    >
      Last Name
      <input
        name="surname"
        type="text"
        autocomplete="family-name"
        placeholder="e.g. Rostova"
        class="rounded-lg border border-field-line bg-panel px-4 py-3 font-body text-sm text-ink placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-accent-fill"
      />
    </label>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <label
      class="flex flex-col gap-1.5 font-display text-[11px] uppercase tracking-wider text-muted"
    >
      Email Address
      <input
        name="email"
        type="email"
        required
        autocomplete="email"
        placeholder="name@company.com"
        class="rounded-lg border border-field-line bg-panel px-4 py-3 font-body text-sm text-ink placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-accent-fill"
      />
    </label>
    <label
      class="flex flex-col gap-1.5 font-display text-[11px] uppercase tracking-wider text-muted"
    >
      Phone Number
      <input
        name="phone"
        type="tel"
        required
        autocomplete="tel"
        placeholder="+380..."
        class="rounded-lg border border-field-line bg-panel px-4 py-3 font-body text-sm text-ink placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-accent-fill"
      />
    </label>
  </div>

  <label
    class="flex flex-col gap-1.5 font-display text-[11px] uppercase tracking-wider text-muted"
  >
    Message
    <textarea
      name="message"
      rows="4"
      required
      placeholder="Describe your project, timeline, or inquiry..."
      class="resize-none rounded-lg border border-field-line bg-panel px-4 py-3 font-body text-sm text-ink placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-accent-fill"
    ></textarea>
  </label>

  <button
    type="submit"
    class="flex w-full items-center justify-center gap-2 rounded-xl border border-accent/40 bg-accent-fill py-4 font-display text-lg font-semibold text-white transition hover:bg-accent-hover hover:shadow-[0_0_30px_var(--accent-glow)]"
  >
    Send Message <Icon name="ph:paper-plane-tilt-bold" width={20} height={20} />
  </button>
</form>
