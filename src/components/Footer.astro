---
import { socials } from "../data/socials.json";
import { Icon } from "astro-icon/components";
---

<footer class="mt-24 border-t border-line bg-panel">
  <div
    class="mx-auto flex w-full max-w-page flex-col items-center justify-between gap-6 px-6 py-10 md:flex-row lg:px-12"
  >
    <div
      class="flex flex-col items-center gap-2 text-center sm:flex-row sm:text-left"
    >
      <span
        class="flex h-9 w-9 items-center justify-center rounded-full bg-panel-raised font-display text-sm font-semibold text-accent"
        >OM</span
      >
      <p class="text-sm text-muted">
        © {new Date().getFullYear()} Olexiy Melnychuk. Engineered with precision.
      </p>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-4">
      {
        socials.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={social.text}
            class="flex h-9 w-9 items-center justify-center rounded-lg bg-panel-raised text-muted transition hover:bg-line hover:text-accent"
          >
            <Icon name={social.icon} width={18} height={18} />
          </a>
        ))
      }
      <a
        href="#hero"
        aria-label="Back to top"
        class="flex h-9 w-9 items-center justify-center rounded-lg bg-panel-raised text-muted transition hover:bg-line hover:text-accent"
      >
        <Icon name="ph:arrow-up-bold" width={18} height={18} />
      </a>
    </div>
  </div>
</footer>
