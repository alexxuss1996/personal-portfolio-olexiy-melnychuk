---
import SkillCard from "@components/SkillCard.astro";
import { skills } from "../data/skills.json";
---

<section
  id="skills"
  class="relative overflow-hidden border-y border-line bg-panel py-24"
>
  <div
    class="pointer-events-none absolute -right-32 top-1/4 h-96 w-96 rounded-full bg-accent/10 blur-[130px]"
  >
  </div>
  <div
    class="relative z-10 mx-auto w-full max-w-page px-4 sm:px-6 lg:px-8"
  >
    <div class="mx-auto mb-16 max-w-2xl text-center">
      <h2 class="font-display text-4xl font-semibold tracking-tight">
        Technical Stack &amp; Mastery
      </h2>
      <p class="mt-3 text-sm leading-6 text-muted">
        Specialized in creating robust front-end web apps with clean separation
        of concerns and maintainable codebases.
      </p>
    </div>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        skills.map(({ id, title, icon, description }, index) => (
          <SkillCard
            id={id}
            icon={icon}
            title={title}
            description={description}
            tone={["accent", "sky", "teal"][index % 3] as "accent" | "sky" | "teal"}
          />
        ))
      }
    </div>
  </div>
</section>
