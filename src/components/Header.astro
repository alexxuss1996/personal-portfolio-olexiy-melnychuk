---
import ThemeButton from "@components/ThemeButton.astro";
import Logo from "@components/Logo.astro";
import { Icon } from "astro-icon/components";
---

<header class="fixed inset-x-0 top-0 z-50 px-4 pt-4 sm:px-6 lg:px-8">
  <div class="mx-auto flex h-16 max-w-page items-center justify-between rounded-full border border-line bg-glass px-4 shadow-[0_8px_30px_rgb(0_0_0/0.35)] backdrop-blur-2xl sm:px-6">
    <a
      href="#hero"
      class="flex items-center gap-3"
      aria-label="Olexiy Melnychuk — home"
    >
      <Logo size={30} />
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label="Main">
      <a href="#hero" class="font-display text-sm text-accent">
        Overview
      </a>
      <a
        href="#projects"
        class="font-display text-sm text-muted transition-colors hover:text-ink"
      >
        Projects
      </a>
      <a
        href="#skills"
        class="font-display text-sm text-muted transition-colors hover:text-ink"
      >
        Stack
      </a>
      <a
        href="#contact"
        class="font-display text-sm text-muted transition-colors hover:text-ink"
      >
        Contact
      </a>
    </nav>

    <div class="flex items-center gap-2">
      <ThemeButton />
      <a
        href="/frontend-olexiy-melnychuk-cv.pdf"
        download
        class="hidden items-center gap-1.5 rounded-full border border-accent/30 bg-accent-fill px-4 py-1.5 font-display text-sm text-white transition hover:bg-accent-hover sm:inline-flex"
      >
        <Icon name="ph:download-simple-bold" width={16} height={16} /> CV
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="flex h-9 w-9 items-center justify-center rounded-full bg-panel-raised text-ink md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <Icon name="ph:list-bold" width={18} height={18} />
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="mx-auto mt-2 hidden max-w-page rounded-2xl border border-line bg-glass p-2 backdrop-blur-2xl md:hidden"
    aria-label="Mobile"
  >
    <a
      href="#hero"
      class="block rounded-xl px-4 py-3 font-display text-sm text-accent"
    >
      Overview
    </a>
    <a
      href="#projects"
      class="block rounded-xl px-4 py-3 font-display text-sm text-muted hover:bg-panel-raised hover:text-ink"
    >
      Projects
    </a>
    <a
      href="#skills"
      class="block rounded-xl px-4 py-3 font-display text-sm text-muted hover:bg-panel-raised hover:text-ink"
    >
      Stack
    </a>
    <a
      href="#contact"
      class="block rounded-xl px-4 py-3 font-display text-sm text-muted hover:bg-panel-raised hover:text-ink"
    >
      Contact
    </a>
    <a
      href="/frontend-olexiy-melnychuk-cv.pdf"
      download
      class="mt-1 block rounded-xl bg-accent-fill px-4 py-3 text-center font-display text-sm font-semibold text-white"
    >
      Download CV
    </a>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-nav");

  toggle?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
    const open = !menu?.classList.contains("hidden");
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
      toggle?.setAttribute("aria-label", "Open menu");
    });
  });
</script>
