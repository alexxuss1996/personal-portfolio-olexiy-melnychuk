---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

export interface ProjectCardProps {
  id?: number;
  image: string;
  title: string;
  tags: string[];
  description: string;
  demo: string;
  github: string;
}

const { title, description, demo, github, image, tags } =
  Astro.props as ProjectCardProps;
const images = import.meta.glob<{ default: ImageMetadata }>(
  "../images/projects/*.{jpeg,jpg,png,gif}",
);
---

<article
  class="group flex flex-col overflow-hidden rounded-card bg-panel ring-1 ring-line transition duration-300 hover:-translate-y-1.5 hover:shadow-[0_12px_36px_rgb(0_0_0/0.25)]"
>
  <div class="relative aspect-[16/10] overflow-hidden bg-panel-raised">
    <Image
      width={640}
      height={400}
      quality={75}
      format="webp"
      alt={title}
      src={images[image]()}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-panel/80 to-transparent opacity-60"
    >
    </div>
    {
      tags[0] && (
        <span class="absolute right-3 top-3 rounded-full bg-canvas/80 px-2.5 py-1 font-display text-[11px] font-semibold uppercase tracking-wider text-accent backdrop-blur-md">
          {tags[0]}
        </span>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-5">
    <ul class="mb-3 flex flex-wrap gap-1.5">
      {
        tags.map((tag) => (
          <li class="rounded bg-panel-raised px-2 py-0.5 font-display text-[11px] text-muted">
            {tag}
          </li>
        ))
      }
    </ul>
    <h3 class="mb-2 break-words font-display text-2xl font-semibold leading-tight">
      {title}
    </h3>
    <p class="mb-6 line-clamp-3 break-words text-sm leading-5 text-muted">
      {description}
    </p>
    <div class="mt-auto flex items-center gap-3 border-t border-line pt-4">
      <a
        href={demo}
        target="_blank"
        rel="noopener noreferrer"
        class="flex flex-1 items-center justify-center gap-1.5 rounded-lg border border-accent/30 bg-accent-fill py-2 font-display text-sm font-medium text-white transition hover:bg-accent-hover"
      >
        Live Demo <Icon name="ph:arrow-square-out-bold" width={16} height={16} />
      </a>
      <a
        href={github}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1 rounded-lg bg-panel-raised px-3 py-2 font-display text-sm text-ink transition hover:bg-line"
      >
        <Icon name="ph:code-bold" width={16} height={16} /> GitHub
      </a>
    </div>
  </div>
</article>
