---
import ContactForm from "@components/ContactForm.astro";
import { socials } from "../data/socials.json";
import { Icon } from "astro-icon/components";

const direct = socials.filter((social) =>
  ["fa:phone", "fa:envelope", "fa:telegram"].includes(social.icon),
);
const networks = socials.filter((social) =>
  ["fa:linkedin", "fa:github", "fa:twitter"].includes(social.icon),
);

const labels: Record<string, string> = {
  "fa:phone": "Direct Phone",
  "fa:envelope": "Email Address",
  "fa:telegram": "Telegram",
};

const networkLabels: Record<string, string> = {
  "fa:linkedin": "LinkedIn",
  "fa:github": "GitHub",
  "fa:twitter": "Twitter",
};
---

<section
  id="contact"
  class="mx-auto w-full max-w-page px-4 py-24 sm:px-6 lg:px-8"
>
  <div
    class="relative overflow-hidden rounded-panel bg-panel p-8 shadow-2xl ring-1 ring-line sm:p-12 lg:p-16"
  >
    <div
      class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full bg-accent/20 blur-[90px]"
    >
    </div>

    <div
      class="relative z-10 grid grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-16"
    >
      <div
        class="flex h-full flex-col justify-between space-y-8 lg:col-span-5"
      >
        <div>
          <h2
            class="font-display text-4xl font-semibold leading-tight tracking-tight"
          >
            Let’s engineer something exceptional together.
          </h2>
          <p class="mt-4 text-sm leading-6 text-muted">
            I am open to full-time engineering roles, contract opportunities,
            and open-source collaborations. Drop me a line anytime.
          </p>
        </div>

        <div class="space-y-3.5">
          {
            direct.map((item) => (
              <a
                href={item.url}
                class="group flex items-center gap-3.5 rounded-xl bg-panel-raised p-3 transition hover:text-accent"
              >
                <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-canvas text-accent">
                  <Icon name={item.icon} width={18} height={18} />
                </span>
                <span class="flex min-w-0 flex-col">
                  <span class="font-display text-[11px] uppercase tracking-wider text-muted">
                    {labels[item.icon]}
                  </span>
                  <span class="truncate font-display text-lg font-semibold">
                    {item.text}
                  </span>
                </span>
              </a>
            ))
          }

          <div class="grid grid-cols-3 gap-2.5 pt-2">
            {
              networks.map((item) => (
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex flex-col items-center rounded-xl bg-panel-raised p-3 text-center transition hover:bg-line"
                >
                  <span class="mb-1 font-display text-[11px] text-accent">
                    {networkLabels[item.icon]}
                  </span>
                  <span class="font-display text-[11px] text-muted group-hover:text-ink">
                    {item.text.replace(/^https?:\/\/(www\.)?/, "")}
                  </span>
                </a>
              ))
            }
          </div>
        </div>

        <a
          href="/frontend-olexiy-melnychuk-cv.pdf"
          download
          class="inline-flex items-center gap-2 font-display text-lg font-semibold text-accent transition hover:text-ink"
        >
          <Icon name="ph:download-simple-bold" width={20} height={20} />
          Download CV (PDF)
        </a>
      </div>

      <div
        class="rounded-card bg-panel-raised/70 p-6 backdrop-blur-md sm:p-8 lg:col-span-7"
      >
        <ContactForm />
      </div>
    </div>
  </div>
</section>
